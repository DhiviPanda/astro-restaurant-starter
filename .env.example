# ─── CONTENIDO ─────────────────────────────────────────────
# false → usa /src/data/mock/*.json + catalog.json (desarrollo sin WordPress)
# true  → conecta a WordPress + Polylang REST API
WP_MODE=false
WP_API_URL=https://cms.tudominio.com/wp-json/wp/v2

# ─── FORMULARIOS ───────────────────────────────────────────
# Clave gratuita de https://web3forms.com (lista de la parrilla + grupos)
# Vacío = los formularios no envían y avisan en consola
PUBLIC_WEB3FORMS_KEY=

# ─── ANALYTICS ─────────────────────────────────────────────
# ID de GA4. Vacío = no se carga ningún script de analytics
PUBLIC_GA_ID=
