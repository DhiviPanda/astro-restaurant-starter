---
import { localePath, type Locale } from '../../i18n/index.ts';

interface Props { t: any; locale: Locale; producers: any[]; }
const { t, locale, producers } = Astro.props;

const carne = producers.find((p) => p.slug === 'la-erilla');
const pan = producers.find((p) => p.slug === 'obrador-cava-baja');
---

<footer class="credits">
  <div class="credits-inner">
    <p class="credits-logo">{t.site.name}</p>

    <p class="credits-key">{t.credits.direccion}</p>
    <p>{t.site.address} · {t.site.district} · {t.site.city}</p>

    <p class="credits-key">{t.credits.parrilla}</p>
    <p>{t.credits.parrillaName}</p>

    {carne && <>
      <p class="credits-key">{t.credits.carne}</p>
      <p>{carne.name} · {carne.place}</p>
    </>}

    {pan && <>
      <p class="credits-key">{t.credits.pan}</p>
      <p>{pan.name}</p>
    </>}

    <p class="credits-end serif-it">{t.site.tagline}</p>

    <nav class="credits-nav">
      <a href={localePath('/carta', locale)}>{t.nav.carta}</a>
      <a href={localePath('/grupos', locale)}>{t.nav.grupos}</a>
      <a href={localePath('/cookies', locale)}>Cookies</a>
    </nav>

    <p class="credits-fin">{t.credits.end}</p>
  </div>
</footer>

<style is:global>
  .credits-nav {
    margin-top: 36px; display: flex; gap: 22px; justify-content: center; flex-wrap: wrap;
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
  }
  .credits-nav a { opacity: 0.7; }
  .credits-nav a:hover { opacity: 1; color: var(--red-dark); }
</style>
