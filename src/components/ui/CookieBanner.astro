---
import { getLocaleFromUrl, localePath } from '../../i18n/index.ts';
const locale = getLocaleFromUrl(Astro.url);

const texts: Record<string, { title: string; body: string; accept: string; reject: string; policy: string }> = {
  es: {
    title: 'Cookies',
    body: 'Usamos cookies de analítica para entender cómo se usa la web. No vendemos tus datos.',
    accept: 'Aceptar', reject: 'Rechazar', policy: 'Política de cookies',
  },
  en: {
    title: 'Cookies',
    body: 'We use analytics cookies to understand how the site is used. We never sell your data.',
    accept: 'Accept', reject: 'Decline', policy: 'Cookie policy',
  },
  fr: {
    title: 'Cookies',
    body: 'Nous utilisons des cookies analytiques pour comprendre comment le site est utilisé. Nous ne vendons pas vos données.',
    accept: 'Accepter', reject: 'Refuser', policy: 'Politique de cookies',
  },
};
const c = texts[locale] ?? texts.es;

// CHECKPOINT: pon tu ID de GA4 en .env (PUBLIC_GA_ID). Vacio = sin analytics.
const GA_ID = import.meta.env.PUBLIC_GA_ID ?? '';
---

<div id="cookie-banner" class="cookies" role="dialog" aria-label={c.title} hidden>
  <div class="cookies-text">
    <strong class="cookies-title">{c.title}</strong>
    <p class="cookies-body">
      {c.body} <a href={localePath('/cookies', locale)}>{c.policy}</a>
    </p>
  </div>
  <div class="cookies-actions">
    <button id="cookie-reject" class="btn-cookie is-ghost">{c.reject}</button>
    <button id="cookie-accept" class="btn-cookie is-yellow">{c.accept}</button>
  </div>
</div>

{GA_ID && (
  <>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        wait_for_update: 500,
      });
      gtag('js', new Date());
      gtag('config', GA_ID, { anonymize_ip: true });
      try {
        if (localStorage.getItem('cookie_consent') === 'accepted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  </>
)}

<style is:global>
  .cookies {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    z-index: 9000; width: calc(100% - 40px); max-width: 660px;
    background: var(--ink); color: var(--paper);
    border: 2px solid var(--red-dark);
    padding: 20px 24px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px; flex-wrap: wrap;
  }
  .cookies[hidden] { display: none; }

  .cookies-title {
    font-family: var(--display); font-size: 19px; letter-spacing: 0.1em;
    display: block; margin-bottom: 4px; text-transform: uppercase;
  }
  .cookies-body { font-size: 12px; line-height: 1.6; max-width: 46ch; opacity: 0.85; }
  .cookies-body a { color: var(--yellow); text-decoration: underline; text-underline-offset: 2px; }

  .cookies-actions { display: flex; gap: 10px; flex-shrink: 0; }
  .btn-cookie {
    padding: 11px 20px; border-radius: 0;
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.2em; text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
  }
  .btn-cookie.is-yellow { background: var(--yellow); color: var(--ink); }
  .btn-cookie.is-yellow:hover { background: var(--paper); }
  .btn-cookie.is-ghost {
    background: transparent; color: var(--paper);
    border: 1px solid rgba(242, 237, 230, 0.5);
  }
  .btn-cookie.is-ghost:hover { border-color: var(--paper); }

  @media (max-width: 600px) {
    .cookies { bottom: 0; left: 0; right: 0; width: 100%; transform: none; border-width: 2px 0 0; }
  }
</style>

<script>
  const banner = document.getElementById('cookie-banner');
  const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const write = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

  if (banner && !read('cookie_consent')) {
    setTimeout(() => banner.removeAttribute('hidden'), 1200);
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    write('cookie_consent', 'accepted');
    banner?.setAttribute('hidden', '');
    (window as any).gtag?.('consent', 'update', { analytics_storage: 'granted' });
  });

  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    write('cookie_consent', 'rejected');
    banner?.setAttribute('hidden', '');
  });
</script>
