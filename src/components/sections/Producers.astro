---
import { Image } from 'astro:assets';
import { asset, ANCHOS, SIZES, CALIDAD } from '../../utils/images.ts';

interface Props { producers: any[]; }
const { producers } = Astro.props;
---

<div class="prods">
  {producers.map((p) => (
    <article class="prod">
      <figure class="prod-shot">
        <Image
          src={asset(p.img)}
          widths={[...ANCHOS.retrato]}
          sizes={SIZES.retrato}
          quality={CALIDAD}
          alt="" loading="lazy" decoding="async"
        />
      </figure>
      <h3 class="prod-name">{p.name}</h3>
      <p class="prod-place">{p.place}</p>
      <p class="prod-note serif-it">{p.note}</p>
    </article>
  ))}
</div>

<style is:global>
  .prods {
    background: var(--bg);
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-bottom: var(--rule);
  }
  .prod {
    border-right: var(--rule);
    padding: 0 0 clamp(26px, 3vw, 36px);
  }
  .prod:last-child { border-right: none; }

  .prod-shot { aspect-ratio: 3 / 2; overflow: hidden; background: var(--ink); }
  .prod-shot img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.35);
  }

  .prod-name {
    font-family: var(--display);
    font-size: clamp(26px, 3.2vw, 52px); line-height: 0.9;
    margin: 24px clamp(20px, 2vw, 26px) 0; text-transform: uppercase;
  }
  .prod-place {
    margin: 8px clamp(20px, 2vw, 26px) 0;
    font-size: 11px; letter-spacing: 0.3em; color: var(--red); text-transform: uppercase;
  }
  .prod-note {
    margin: 14px clamp(20px, 2vw, 26px) 0;
    font-size: 17px; line-height: 1.55;
  }

  @media (max-width: 860px) {
    .prods { grid-template-columns: 1fr; }
    .prod { border-right: none; border-bottom: var(--rule); }
    .prod:last-child { border-bottom: none; }
  }
</style>
