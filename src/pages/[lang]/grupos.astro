---
import GroupsPage from '../../components/GroupsPage.astro';
import { LOCALES, DEFAULT_LOCALE, isValidLocale, type Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return LOCALES
    .filter((l) => l !== DEFAULT_LOCALE)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale: Locale = isValidLocale(lang) ? lang : DEFAULT_LOCALE;
---

<GroupsPage locale={locale} />
