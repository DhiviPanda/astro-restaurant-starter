---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/layout/TopBar.astro';
import Credits from '../components/layout/Credits.astro';
import { getContent } from '../utils/content.ts';
import { DEFAULT_LOCALE } from '../i18n/index.ts';

const { t, producers } = await getContent(DEFAULT_LOCALE);

const sections = [
  {
    h: '¿Qué son las cookies?',
    p: 'Las cookies son pequeños archivos de texto que los sitios web guardan en tu dispositivo cuando los visitas. Permiten recordar tus preferencias y entender cómo se usa la web.',
  },
  {
    h: 'Cookies que usamos',
    p: 'Solo cookies analíticas de Google Analytics 4 para saber qué páginas se visitan y de dónde llega el tráfico. No usamos cookies publicitarias ni vendemos datos a terceros.',
  },
  {
    h: 'Almacenamiento en tu navegador',
    p: 'La carta guarda en tu propio navegador los filtros de alérgenos que marcas y el plato que señalas como "lo de siempre". Esa información no sale de tu dispositivo y no llega a nuestros servidores.',
  },
  {
    h: 'Tu consentimiento',
    p: 'La primera vez que entras te pedimos permiso antes de activar cualquier cookie de analítica. Puedes aceptar o rechazar. Tu decisión se guarda en tu navegador y puedes cambiarla borrando los datos de navegación.',
  },
  {
    h: 'Más información',
    p: 'Para cualquier consulta sobre esta política, escríbenos a ' + t.site.email + '.',
  },
];
---

<BaseLayout title={`Política de cookies — ${t.site.name}`} description="Información sobre el uso de cookies." noindex>
  <TopBar t={t} locale={DEFAULT_LOCALE} />

  <main class="legal">
    <h1 class="legal-title">Política de cookies</h1>
    {sections.map((s) => (
      <section class="legal-section">
        <h2 class="legal-h2">{s.h}</h2>
        <p class="legal-p">{s.p}</p>
      </section>
    ))}
    <a href="/" class="legal-back">← Volver al inicio</a>
  </main>

  <Credits t={t} locale={DEFAULT_LOCALE} producers={producers} />
</BaseLayout>

<style is:global>
  .legal { max-width: 720px; margin: 0 auto; padding: clamp(50px, 8vw, 90px) var(--pad); }
  .legal-title {
    font-family: var(--display); font-size: clamp(44px, 9vw, 110px);
    line-height: 0.85; text-transform: uppercase;
  }
  .legal-section { margin-top: 42px; padding-top: 30px; border-top: 1px solid rgba(10,10,10,0.15); }
  .legal-h2 {
    font-family: var(--display); font-size: clamp(20px, 2.6vw, 30px);
    line-height: 1; text-transform: uppercase; color: var(--red);
  }
  .legal-p { margin-top: 12px; font-size: 15px; line-height: 1.85; }
  .legal-back {
    display: inline-block; margin-top: 44px;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    border-bottom: 1px solid var(--ink); padding-bottom: 3px;
  }
  .legal-back:hover { color: var(--red); border-color: var(--red); }
</style>
