---
import { FALLBACK_SITE } from '../config.ts';
import { getLocaleFromUrl, getHreflangTags } from '../i18n/index.ts';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/og-default.svg', noindex = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const hreflangTags = getHreflangTags(Astro.url.pathname, locale);
const siteUrl = Astro.site ?? new URL(FALLBACK_SITE);
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fuentes locales (OFL, licencias en /public/fonts/).
         Cero peticiones a terceros: nada que consentir, nada que bloquee el render.
         Solo se precargan las tres que aparecen en la primera pantalla. -->
    <link rel="preload" href="/fonts/special-elite-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bebas-neue-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-300-italic.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL.href} />

    {hreflangTags.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={new URL(href, siteUrl).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl).href} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={new URL(image, siteUrl).href} />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content="BRASA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl).href} />

    <!-- CHECKPOINT: cabeceras de seguridad en el servidor.
         Netlify → netlify.toml · Vercel → vercel.json · Apache → .htaccess
         X-Frame-Options: SAMEORIGIN
         X-Content-Type-Options: nosniff
         Referrer-Policy: strict-origin-when-cross-origin
         Permissions-Policy: camera=(), microphone=(), geolocation=() -->

    <slot name="head" />

    <style is:global>
      /* ── Fuentes ──
         font-display: swap → el texto se lee desde el primer frame con la
         fuente de sistema y cambia al cargar. Nunca hay texto invisible. */
      @font-face {
        font-family: 'Bebas Neue';
        src: url('/fonts/bebas-neue-400.woff2') format('woff2');
        font-weight: 400; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Cormorant';
        src: url('/fonts/cormorant-300-italic.woff2') format('woff2');
        font-weight: 300; font-style: italic; font-display: swap;
      }
      @font-face {
        font-family: 'Cormorant';
        src: url('/fonts/cormorant-400-italic.woff2') format('woff2');
        font-weight: 400; font-style: italic; font-display: swap;
      }
      @font-face {
        font-family: 'Special Elite';
        src: url('/fonts/special-elite-400.woff2') format('woff2');
        font-weight: 400; font-style: normal; font-display: swap;
      }

      :root {
        --bg:        #f2ede6;
        --bg-alt:    #ede8df;
        --bg-clean:  #ffffff;
        --ink:       #0a0a0a;
        --ink-soft:  rgba(10, 10, 10, 0.62);
        --paper:     #f2ede6;
        --red:       #c8001a;
        /* El rojo de marca sobre negro da 3.3:1 y no pasa AA en texto pequeño.
           Esta variante aclarada da 4.9:1 y se usa SOLO sobre fondo oscuro. */
        --red-dark:  #f03045;
        --yellow:    #e8c840;

        --display: 'Bebas Neue', Impact, sans-serif;
        --serif:   'Cormorant', Georgia, serif;
        --mono:    'Special Elite', Courier, monospace;

        --pad: clamp(20px, 4vw, 48px);
        --rule: 1px solid var(--ink);

        /* Opacidad de los estados atenuados (plato no disponible hoy,
           plato bloqueado por un filtro de alergenos).
           0.57 es el suelo exacto para 4.5:1 de tinta sobre --bg.
           0.6 deja margen. Por debajo deja de cumplir AA.
           Ojo: esto vale para la tinta, NO para el rojo, que necesitaria
           0.84 para cumplir. Por eso los textos en rojo cambian a tinta
           cuando se atenuan en vez de bajar de opacidad. */
        --dim: 0.6;
      }

      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--mono);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; text-decoration: none; }
      img, video { max-width: 100%; height: auto; display: block; }
      button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

      ::selection { background: var(--yellow); color: var(--ink); }
      :focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }

      .sr-only {
        position: absolute; width: 1px; height: 1px;
        padding: 0; margin: -1px; overflow: hidden;
        clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }

      /* Honeypot antispam. display:none a propósito, no .sr-only:
         con .sr-only el campo sigue en el arbol de accesibilidad y un
         usuario de lector de pantalla puede marcarlo sin saberlo, con lo
         que su envio se descarta en silencio. Los bots lo rellenan igual. */
      .honeypot { display: none; }

      /* ── Tipografía de escena ── */
      .display { font-family: var(--display); line-height: 0.84; letter-spacing: -0.01em; }
      .serif-it { font-family: var(--serif); font-style: italic; font-weight: 300; }
      .label {
        font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
      }

      /* ── Barra superior ── */
      .topbar {
        display: flex; justify-content: space-between; align-items: center;
        gap: 10px; flex-wrap: nowrap;
        padding: 10px var(--pad);
        border-bottom: var(--rule);
        font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
        position: sticky; top: 0; z-index: 60;
        background: var(--bg);
        min-height: 41px;
      }
      .topbar-group { display: flex; gap: 16px; align-items: center; flex-wrap: nowrap; }
      .topbar a:hover { color: var(--red); }
      .topbar .is-red { color: var(--red); }
      /* En móvil pequeño ocultamos los links de nav para que no rompa */
      @media (max-width: 480px) {
        .topbar-group > a:not(.topbar-logo) { display: none; }
        .topbar-group > .state { display: none; }
      }

      /* Indicador abierto/cerrado */
      .state { display: inline-flex; align-items: center; gap: 7px; }
      .state-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--ink); flex-shrink: 0;
      }
      .state.is-open .state-dot { background: var(--red); animation: pulse 2.4s ease-in-out infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

      /* ── Botones ── */
      .btn {
        display: inline-block; border-radius: 0;
        padding: 16px 34px;
        font-family: var(--mono);
        font-size: 13px; letter-spacing: 0.28em; text-transform: uppercase;
        transition: background 0.2s, color 0.2s;
      }
      .btn-red    { background: var(--red);    color: var(--paper); }
      .btn-red:hover { background: var(--ink); color: var(--paper); }
      .btn-ink    { background: var(--ink);    color: var(--paper); }
      .btn-ink:hover { background: var(--red); color: var(--paper); }
      .btn-yellow { background: var(--yellow); color: var(--ink); }
      .btn-yellow:hover { background: var(--red); color: var(--paper); }
      .btn-paper  { background: var(--paper);  color: var(--ink); }
      .btn-paper:hover { background: var(--ink); color: var(--paper); }

      /* ── Capítulo: corte a negro ── */
      .chapter {
        background: var(--ink); color: var(--paper);
        padding: clamp(70px, 11vw, 130px) var(--pad);
        text-align: center;
        position: relative;
      }
      .chapter-label { color: var(--red-dark); letter-spacing: 0.4em; font-size: 12px; text-transform: uppercase; }
      .chapter-title {
        font-family: var(--display);
        font-size: clamp(56px, 13vw, 230px);
        line-height: 0.85; margin-top: 12px;
      }
      .chapter-sub {
        margin-top: 22px;
        font-family: var(--serif); font-style: italic;
        font-size: clamp(18px, 2vw, 30px);
        color: var(--bg-alt);
      }

      /* El goteo que rompe el marco */
      .drip {
        position: absolute; top: -88px; left: 12vw;
        width: 24px; height: 200px; background: var(--red);
        clip-path: polygon(0 0, 100% 0, 100% 74%, 50% 100%, 0 74%);
        z-index: 20; pointer-events: none;
      }

      /* ── Rejilla de fondo del hero ── */
      .scanlines {
        position: absolute; inset: 0; z-index: 0; pointer-events: none;
        background-image: repeating-linear-gradient(90deg, var(--ink) 0 1px, transparent 1px 9px);
        opacity: 0.05;
      }

      /* ── Pie de créditos ── */
      .credits {
        background: var(--ink); color: var(--paper);
        padding: clamp(60px, 9vw, 100px) var(--pad) 56px;
      }
      .credits-inner {
        max-width: 640px; margin: 0 auto; text-align: center;
        font-size: 11px; letter-spacing: 0.22em; line-height: 2.6;
        text-transform: uppercase;
      }
      .credits-logo {
        font-family: var(--display); font-size: 56px;
        letter-spacing: 0.04em; line-height: 1; margin-bottom: 34px;
      }
      .credits-key { color: var(--red-dark); margin-top: 26px; }
      .credits-end {
        margin-top: 44px; font-family: var(--serif); font-style: italic;
        font-size: 20px; letter-spacing: 0; text-transform: none;
      }
      .credits-fin { margin-top: 32px; opacity: 0.55; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
